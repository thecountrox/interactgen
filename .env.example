# Environment Configuration
# =========================
# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Google Gemini Configuration (for embeddings and LLM)
GEMINI_API_KEY=your-gemini-api-key

# Gemini Rate Limiting
# Set to "true" if using free tier to enforce rate limits
# Set to "false" if using paid tier (no rate limiting)
TRIAL_GEMINI_TOKEN=true

# Local LLM Configuration (Ollama)
# Set to "true" to use local models instead of Gemini API
# Requires Ollama installed: curl -fsSL https://ollama.com/install.sh | sh
USE_LOCAL_LLM=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Test User Configuration
# This UUID should match a user profile in your Supabase profiles table
# You can create a test profile or use an existing user's UUID
TEST_USER_ID=your-test-user-uuid-here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://your-extension-id
